# AI parser (Cerebras, OpenAI-compatible). Leave the key empty to use the rule-based fallback.
CEREBRAS_API_KEY=
# Check Cerebras docs / GET /v1/models for currently available model ids, e.g. gpt-oss-120b or qwen-3.8-27b
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Prototype settings
# Escalation time per stage, in seconds. The Admin page can change these while the app runs.
ACCEPT_ESCALATE_SECONDS=120   # customer places request -> someone accepts
DELIVER_ESCALATE_SECONDS=120  # accepted -> item on its way to the customer
ALTERATION_OFFERED=true

# Several items per trip (1-5)
BRING_COUNT=3

# Routing waits, in seconds. The Admin page can change these (and builds the team) while the app runs.
PRIMARY_WAIT_SECONDS=20    # primary person has it, then a backup is added too
SECONDARY_WAIT_SECONDS=20  # backup has it, then it opens to everyone
STAFF_ACTIVE_SECONDS=60    # a phone counts as on this long after it last polled
ROOM_SESSION_MINUTES=30    # a fitting room with nothing open is empty again after this long (Admin can change it)

# Store signals (observations on the Manager screen)
SIGNAL_MIN_N=3
SIGNAL_MIN_SHARE=0.6
SIGNAL_MIN_MISSES=1
SIGNAL_MIN_PULLS=2
SMALL_SAMPLE_N=5

# Demo controls on the Manager screen (force the rule-based fallback, fast timers).
# They affect everyone using the app, so keep this OFF on a public deploy.
DEMO_CONTROLS=false

PORT=3000
DATA_FILE=data/events.jsonl
